          '  };\n' +
          '  await registerPage.goto();\n' +
          '  await registerPage.startSignup(user.firstName, user.email);\n' +
          '  await registerPage.fillAccountDetails(user);\n' +
          '  await registerPage.confirmAccountCreated();\n' +
          `  await (0, _test.expect)(page.locator('a:has-text("Logged in as")')).toContainText(user.firstName);\n` +
