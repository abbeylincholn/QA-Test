  test_code: 'async ({\n' +
    '  page\n' +
    '}) => {\n' +
    '  const loginPage = new _LoginPage.LoginPage(page);\n' +
    '  const productsPage = new _ProductsPage.ProductsPage(page);\n' +
    '  const cartPage = new _CartPage.CartPage(page);\n' +
    '  const checkoutPage = new _CheckoutPage.CheckoutPage(page);\n' +
    '  const {\n' +
    '    payment,\n' +
    '    newUser,\n' +
    '    products,\n' +
    '    search\n' +
    '  } = _TestData.default;\n' +
    '  const items = products.productsToAdd2;\n' +
    '  await loginPage.goto();\n' +
    '  await loginPage.loginWithValidCredentials({\n' +
    '    username: process.env.AE_USERNAME,\n' +
    '    password: process.env.AE_PASSWORD\n' +
    '  });\n' +
    '  await cartPage.clearCart();\n' +
    '  await productsPage.goto();\n' +
    '  await productsPage.searchFor(search.productName2);\n' +
    '  for (let i = 0; i < items.length; i++) {\n' +
    '    await productsPage.addProductToCart(items[i]);\n' +
    '    i === items.length - 1 ? await productsPage.goToCart() : await productsPage.continueShopping();\n' +
    '  }\n' +
    '  await cartPage.expectCartHasItems(items.length);\n' +
    '  await cartPage.expectProductInCart(search.productName2);\n' +
    '  await cartPage.proceedToCheckout();\n' +
    '  await checkoutPage.expectDeliveryAddressContains(`${newUser.address.firstName} ${newUser.address.lastName}`);\n' +
    '  await checkoutPage.expectDeliveryAddressContains(newUser.address.company);\n' +
    '  await checkoutPage.expectDeliveryAddressContains(newUser.address.address1);\n' +
    '  await checkoutPage.expectDeliveryAddressContains(newUser.address.city);\n' +
    '  await checkoutPage.expectDeliveryAddressContains(newUser.address.state);\n' +
    '  await checkoutPage.expectDeliveryAddressContains(newUser.address.zipCode);\n' +
    '  await checkoutPage.expectDeliveryAddressContains(newUser.address.mobileNumber);\n' +
    '  await checkoutPage.clickPlaceOrder();\n' +
    '  await checkoutPage.fillPaymentDetails(payment);\n' +
    '  await checkoutPage.expectOrderPlaced();\n' +
    '}',
